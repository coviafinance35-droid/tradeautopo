# ==========================================
# Pump.fun LaunchGuard Configuration
# ==========================================

# GEMINI_API_KEY: Optional AI assistant for risk summaries and pattern insights
GEMINI_API_KEY=""

# APP_URL: Public domain of the application
APP_URL=""

# Solana Network & RPC Configuration (Free tiers: Helius, QuickNode, Alchemy, or public solana mainnet)
SOLANA_RPC_URL="https://api.mainnet-beta.solana.com"
SOLANA_WSS_URL="wss://api.mainnet-beta.solana.com"

# Secure Owner Authentication Secret
# Used to sign session tokens for owner-only access
SESSION_SECRET="your-random-32-byte-hex-session-secret"
OWNER_PASSCODE="guard2026"

# Trading Wallet (Base58 private key or JSON byte array)
# IMPORTANT: Keep empty during simulation. Never store your main savings wallet.
# Dedicated trading wallet with minimal funds only (e.g. 0.1 - 0.5 SOL).
TRADING_WALLET_PRIVATE_KEY=""

# Safety & Execution Rules
TRADING_MODE="simulation" # Options: "simulation" | "live"
AUTO_BUY_ENABLED="false"
MAX_BUY_SOL="0.05"
MAX_OPEN_EXPOSURE_SOL="0.25"
MAX_DAILY_LOSS_SOL="0.15"
MAX_SLIPPAGE_BPS="500" # 500 bps = 5%
MAX_CONCURRENT_POSITIONS="3"
MIN_LIQUIDITY_SOL="25"
MIN_UNIQUE_BUYERS="3"
MAX_CREATOR_HOLDING_PCT="12"
COOLDOWN_SECONDS="15"

# Database connection (optional PostgreSQL string, fallback to persistent disk store)
DATABASE_URL=""
